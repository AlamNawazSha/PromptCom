# ==========================================
# SCAMSHIELD AI - Environment Configuration
# ==========================================

# Database Connection (SQLite by default for zero-setup local dev; or postgresql://user:pass@host:5432/scamshield)
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (Optional: Falls back to deterministic rule engine if empty or offline)
GEMINI_API_KEY=""

# Domain Reputation Providers (Optional: Falls back to real RDAP and local security heuristics if empty)
GOOGLE_SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiting Configuration
SCAN_RATE_LIMIT=30
SCAN_RATE_WINDOW_MS=60000
